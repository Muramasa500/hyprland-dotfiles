/* ~/.config/waybar/style.css */

/*Change this file for color palette*/
/*@import "themes/theme-catppuccin-mocha.css";*/
@import "themes/theme-catppuccin-macchiato.css";
/*@import "themes/theme-nord.css";*/

/* ========================================== */
/* =====              FONTS             ===== */
/* ========================================== */
* {
    font-family: "JetBrainsMono Nerd Font", "Noto Sans", sans-serif;
    min-height: 0;
}

window#waybar {
    background-color: alpha(@base, 0.95);
    margin: 0px 10px;
    padding: 4px 8px;
    color: @text;
    border-radius: 16px;
    border: 2px solid alpha(@accent-cyan, 0.3);
    box-shadow:
        0 8px 24px alpha(@black, 0.6),
        inset 0 1px 0 alpha(@white, 0.04),
        0 0 20px alpha(@accent-cyan, 0.08);
}

/* ---------------------------------------- */
/* -----           TOOLTIP            ----- */
/* ---------------------------------------- */
tooltip {
    background-color: alpha(@mantle, 0.96);
    border: 2px solid alpha(@accent-cyan, 0.3);
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 6px 24px alpha(@black, 0.5);
}

#tooltip {
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 0;
    font-family: "JetBrainsMono Nerd Font", "Noto Sans", sans-serif;
    font-size: 14px;
}

#tooltip label {
    color: @text;
    background-color: transparent;
    border: none;
    padding: 0;
}

/* ---------------------------------------- */
/* -----          WORKSPACES          ----- */
/* ---------------------------------------- */
#workspaces {
    background-color: alpha(@crust, 0.6);
    border-radius: 12px;
    padding: 2px 2px 2px 8px;
    margin: 2px 2px;
    box-shadow: inset 0 2px 8px alpha(@black, 0.3);
    border: 1px solid alpha(@black, 0.2);
}

#workspaces button {
    background-color: alpha(@surface1, 0.85);
    color: @subtext0;
    font-size: 18px;
    padding: 2px 14px 2px 8px;
    margin: 1px 2px;
    border-radius: 0px;
    transition: all 0.2s ease;
    min-width: 15px;
    border-bottom: 3px solid alpha(@black, 0.25);
    border-top: 1px solid alpha(@white, 0.03);
}

#workspaces button:nth-child(3n + 1) {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    margin-left: 2px;
}

#workspaces button:nth-child(3n) {
    margin-right: 8px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

#workspaces button:hover {
    background-color: alpha(@surface1, 0.8);
    color: @text;
    border-bottom: 3px solid alpha(@accent-green, 0.6);
}

/* ======================================== */
/* -----          ACTIVE COLORS       ----- */
/* ======================================== */
#workspaces button.active {
    font-weight: 700;
    color: @text;
    opacity: 1;
    background-color: alpha(@ws-accent, 0.5);
    border-bottom: 3px solid alpha(@black, 0.3);
}

/* --- Monitor 1 (WS 1-3) --- */
#workspaces button.active:nth-child(1) {
    border-bottom: 3px solid @ws-1;
    box-shadow: 0 0 10px alpha(@ws-1, 0.4);
}
#workspaces button.active:nth-child(2) {
    border-bottom: 3px solid @ws-2;
    box-shadow: 0 0 10px alpha(@ws-2, 0.4);
}
#workspaces button.active:nth-child(3) {
    border-bottom: 3px solid @ws-3;
    box-shadow: 0 0 10px alpha(@accent-green, 0.4);
}

/* --- Monitor 2 (WS 4-6) --- */
#workspaces button.active:nth-child(4) {
    border-bottom: 3px solid @ws-4;
    box-shadow: 0 0 10px alpha(@ws-4, 0.4);
}
#workspaces button.active:nth-child(5) {
    border-bottom: 3px solid @ws-5;
    box-shadow: 0 0 10px alpha(@ws-5, 0.4);
}
#workspaces button.active:nth-child(6) {
    border-bottom: 3px solid @ws-6;
    box-shadow: 0 0 10px alpha(@accent-green, 0.4);
}

/* --- Monitor 3 (WS 7-9) --- */
#workspaces button.active:nth-child(7) {
    border-bottom: 3px solid @ws-7;
    box-shadow: 0 0 10px alpha(@ws-7, 0.4);
}
#workspaces button.active:nth-child(8) {
    border-bottom: 3px solid @ws-8;
    box-shadow: 0 0 10px alpha(@accent-cyan, 0.4);
}
#workspaces button.active:nth-child(9) {
    border-bottom: 3px solid @ws-9;
    box-shadow: 0 0 10px alpha(@ws-9, 0.4);
}

/* Magic workspace */
#workspaces button.active:nth-child(n + 10) {
    border-bottom: 3px solid @ws-10;
    box-shadow: 0 0 10px alpha(@ws-10, 0.4);
}

/* ---------------------------------------- */
/* -----       GENERAL MODULES        ----- */
/* ---------------------------------------- */
#custom-menu,
#custom-weather,
#mpris,
#cpu,
#memory,
#network,
#pulseaudio,
#custom-cliphist,
#tray,
#language,
#clock,
#custom-power {
    border: 1px solid transparent;
    font-weight: bold;
    transition: all 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background-color: transparent;
    color: @text;
}

#custom-weather:hover,
#cpu:hover,
#memory:hover,
#network:hover,
#pulseaudio:hover,
#custom-cliphist:hover,
#language:hover,
#clock:hover {
    background-color: alpha(@accent-cyan, 0.12);
    color: @accent-cyan;
    border-radius: 12px;
    border: 1px solid alpha(@accent-cyan, 0.2);
    box-shadow: 0 0 12px alpha(@accent-cyan, 0.08);
}

/* ---------------------------------------- */
/* -----         LEFT MODULES         ----- */
/* ---------------------------------------- */
#custom-menu {
    color: @accent-cyan;
    padding: 0px 23px 0px 15px;
    margin: 1px 0px 1px 4px;
    transition: all 0.2s;
    font-size: 27px;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
    border-right: 0px;
}

#custom-menu:hover {
    color: @accent-green;
    background-color: alpha(@accent-cyan, 0.1);
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
    border-right: 0px;
}

#custom-weather {
    font-size: 16px;
    padding: 0px 6px 0px 5px;
    margin: 4px 2px;
}

/* ---------------------------------------- */
/* -----        MIDDLE MODULES        ----- */
/* ---------------------------------------- */

/* ---------------------------------------- */
/* -----        RIGHT MODULES         ----- */
/* ---------------------------------------- */
/* Music module */
#mpris {
    background-color: alpha(@base, 0.4);
    box-shadow: 0 4px 16px alpha(@black, 0.25);
    border: 2px solid alpha(@accent-cyan, 0.2);
    border-radius: 12px;
    color: @text;
    padding: 2px 6px 2px 5px;
    margin: 5px 2px;
    font-size: 15px;
    font-weight: bold;
}

#mpris:hover {
    background-color: alpha(@accent-cyan, 0.1);
    border: 2px solid alpha(@accent-cyan, 0.35);
    border-radius: 12px;
}

/* CPU & Memory */
#cpu,
#memory {
    font-size: 16px;
    padding: 3px 10px 3px 5px;
    margin: 4px 2px;
}

/* Network */
#network {
    font-size: 18px;
    padding: 3px 8px 3px 3px;
    margin: 4px 2px;
}

/* Volume control */
#pulseaudio {
    background-color: transparent;
    color: @text;
    font-size: 16px;
    padding: 3px 10px 3px 5px;
    margin: 4px 2px;
}

#pulseaudio.muted {
    color: @overlay0;
    font-size: 18px;
    padding: 3px 10px 3px 5px;
    margin: 4px 2px;
}

#custom-cliphist {
    font-size: 16px;
    padding: 3px 1px 3px 5px;
    margin: 4px 2px;
}

#tray {
    padding: 2px 4px;
    font-size: 15px;
    margin: 4px 2px;
}

#language {
    font-size: 16px;
    padding: 0px 3px;
    margin: 4px 2px;
}

#clock {
    font-size: 12px;
    padding: 0px 7px;
    margin: 2px 2px;
}

#custom-power {
    min-width: 20px;
    padding: 0px 7px;
    font-size: 18px;
    margin: 2px 10px 2px 3px;
    font-weight: bold;
}

#custom-power:hover {
    color: @red;
    font-weight: bold;
}
