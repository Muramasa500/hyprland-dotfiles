@import "catppuccin-mocha"

* {
    cyan:   #33ccff;
    green:  #00ff99;

    background-color: transparent;
    border-color:     @cyan;
    text-color:       @text;
}

window {
    padding:          22px;
    background-color: #1e1e2ef2;
    border:           2px solid;
    border-color:     #33ccff40;
    border-radius:    16px;
    width:            550px;
}

mainbox {
    padding: 0;
    border:  0;
    spacing: 14px;
}

inputbar {
    padding:          9px 12px;
    spacing:          10px;
    text-color:       @text;
    background-color: @surface0;
    border-radius:    10px;
    border:           1px solid;
    border-color:     @surface1;
    children:         [ prompt, entry ];
}

entry {
    text-color:        @text;
    background-color:  transparent;
    placeholder-color: @overlay0;
    placeholder:        "Search applications...";
    cursor:             text;
    font:               "JetBrains Mono 13";
}

prompt {
    text-color:       @cyan;
    background-color: @surface1;
    font:             "JetBrainsMono Nerd Font 14";
    border-radius:    7px;
    padding:          4px 9px;
}

listview {
    padding:      2px 0px 0px 0px;
    scrollbar:    true;
    dynamic:      false;
    spacing:      2px;
    fixed-height: false;
    border:       0;
    lines:        12;
}

scrollbar {
    width:            4px;
    padding:          0px 0px 0px 8px;
    handle-color:     @surface2;
    border:           0;
    border-radius:    2px;
    background-color: transparent;
}

scrollbar handle {
    border-radius:    2px;
    background-color: @surface2;
}

element {
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
    background-color: transparent;
    padding:          9px 10px;
    cursor:           pointer;
    spacing:          12px;
    border:           0px 0px 0px 3px;
    border-color:     transparent;
    border-radius:    0px;
}

/* Normal and Alternate rows */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element normal.normal hover,
element alternate.normal hover {
    background-color: #45475a80;
    text-color:       @text;
}

/* Selected: left accent bar + subtle tint, not a full color block */
element selected.normal,
element selected.active {
    background-color: #45475a80;
    text-color:       @cyan;
    border:           0px 0px 0px 3px;
    border-color:     @cyan;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color:       @green;
}

element normal.active hover,
element alternate.active hover {
    background-color: #45475a80;
    text-color:       @green;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    font:             "JetBrains Mono 13";
}

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
    margin-right:     4px;
}

message {
    padding:          12px 16px;
    border:           0;
    background-color: @surface0;
    border-radius:    10px;
}

textbox {
    text-color:       @text;
    background-color: transparent;
}

button {
    cursor:           pointer;
    text-color:       @text;
    padding:          8px 12px;
    border-radius:    8px;
}

button selected {
    background-color: @cyan;
    text-color:       @crust;
    border-radius:    8px;
}
