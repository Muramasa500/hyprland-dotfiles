theme = Catppuccin Mocha
background-opacity = 0.92
background-blur-radius = 20

font-family = "JetBrainsMono Nerd Font"
font-size = 12

window-padding-x = 10
window-padding-y = 10
window-decoration = false

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

window-vsync = true
resize-overlay = never
